---
import { portalHref, GOCABINETS_PORTAL_URL, PHONE, PHONE_HREF } from '../config';
const ext = GOCABINETS_PORTAL_URL ? { target: '_blank', rel: 'noopener' } : {};
const links = [
  ['Our work', '#portfolio'],
  ['3D planner', '#planner'],
  ['Why TCS', '#why'],
  ['For trade', '#trade'],
  ['Materials', '#materials'],
  ['FAQ', '#faq'],
  ['Request a quote', '#quote'],
];
---
<a class="logo-tab" href="#top" aria-label="Total Cabinet Supplies, back to top">
  <img src="/tcs-logo.png" width="1435" height="785" alt="Total Cabinet Supplies" />
</a>

<div class="menu-tab">
  <a class="trade" href={portalHref} {...ext}>Trade Login <span aria-hidden="true">↗</span></a>
  <button class="open" type="button" popovertarget="menu" aria-label="Open menu">
    <span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
</div>

<nav id="menu" popover aria-label="Sections">
  {links.map(([label, href]) => <a href={href}>{label}</a>)}
  <a class="call" href={PHONE_HREF}>{PHONE}</a>
</nav>

<script>
  const menu = document.getElementById('menu')!;
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
</script>

<style>
  .logo-tab {
    position: absolute; top: 0; left: 0; z-index: 20;
    background: #fff; padding: 14px 26px 16px var(--pad);
    border-radius: 0 0 24px 0;
  }
  .logo-tab img { height: 44px; width: auto; mix-blend-mode: multiply; }

  .menu-tab {
    position: fixed; top: 0; right: 0; z-index: 50;
    display: flex; align-items: center; gap: 6px;
    background: var(--accent); color: #fff;
    padding: 10px 14px 12px 22px; border-radius: 0 0 0 24px;
    box-shadow: 0 8px 24px -16px rgb(15 17 17 / .6);
  }
  .trade { font-size: .875rem; font-weight: 600; text-decoration: none; padding: 8px 10px; border-radius: 999px; }
  .trade:hover { background: rgb(255 255 255 / .14); }
  .open {
    width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; cursor: pointer;
    display: grid; place-content: center; gap: 5px;
  }
  .open:hover { background: rgb(255 255 255 / .14); }
  .open span { display: block; width: 18px; height: 2px; border-radius: 2px; background: #fff; }

  #menu {
    inset: 70px var(--pad) auto auto; margin: 0;
    width: min(300px, calc(100vw - 2 * var(--pad)));
    padding: 12px; border: 0; border-radius: var(--radius);
    background: #fff; color: var(--ink);
    box-shadow: 0 24px 48px -24px rgb(15 17 17 / .45);
  }
  #menu:popover-open { display: grid; }
  #menu a { padding: 12px 14px; border-radius: 10px; text-decoration: none; font-weight: 500; }
  #menu a:hover { background: var(--band); }
  #menu .call { margin-top: 6px; border-top: 1px solid var(--rule); border-radius: 0 0 10px 10px; color: var(--accent); font-weight: 600; }
  #menu::backdrop { background: transparent; }

  @media (max-width: 560px) {
    .logo-tab { padding: 10px 18px 12px var(--pad); }
    .logo-tab img { height: 34px; }
    .menu-tab { padding: 8px 10px 10px 16px; }
  }
</style>
