---
import { plannerHref, GOCABINETS_PLANNER_URL } from '../config';
const ext = GOCABINETS_PLANNER_URL ? { target: '_blank', rel: 'noopener' } : {};
---
<section class="hero">
  <img class="photo" src="/jobs/kitchen-sunnybank.jpg" width="1440" height="1080" fetchpriority="high"
    alt="A white gloss U-shaped kitchen with a peninsula bench, made by Total Cabinet Supplies in Sunnybank Hills." />
  <div class="wrap copy">
    <h1 class="dual">Millimetre-Perfect Flat Pack. <b>Engineered for Living &amp; Building.</b></h1>
    <div class="actions">
      <a class="btn btn--white" href={plannerHref} {...ext}>Launch 3D Planner <span aria-hidden="true">↗</span></a>
      <a class="btn btn--line-light" href="#quote">Request a Quote <span class="dot" aria-hidden="true"></span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: max(620px, 100svh);
    display: flex; align-items: flex-end; color: #fff; isolation: isolate; background: var(--dark);
  }
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; z-index: -2; }
  /* neutral scrim, darkest where the headline sits (7.6:1 for white text) */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgb(var(--scrim) / .74) 0%, rgb(var(--scrim) / .5) 38%, rgb(var(--scrim) / .08) 72%, transparent 100%);
  }
  .copy { width: 100%; padding-block: 0 clamp(48px, 8vh, 96px); }
  h1 { font-size: clamp(2.4rem, 5vw, 3.9rem); max-width: 17ch; }
  @media (max-width: 560px) { .hero { min-height: 88svh; } .photo { object-position: 60% 50%; } }
</style>
