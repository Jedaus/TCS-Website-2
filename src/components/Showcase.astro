---
import { plannerHref, GOCABINETS_PLANNER_URL } from '../config';
const ext = GOCABINETS_PLANNER_URL ? { target: '_blank', rel: 'noopener' } : {};
const cols = [
  { title: 'Kitchens', place: 'Carindale', src: '/jobs/kitchen-carindale.jpg', w: 540, h: 960, pos: '50% 60%',
    body: 'Base, wall and tall cabinets cut to your plan, with Polytec and Laminex doors.',
    alt: 'A white gloss kitchen run with a charcoal splashback and timber floor, made by Total Cabinet Supplies in Carindale.' },
  { title: 'Wardrobes', place: 'Brisbane', src: '/jobs/wardrobe-carcass.jpg', w: 1125, h: 2000, pos: '40% 55%',
    body: 'Built-ins and walk-in robes, System 32 drilled so shelves move without new holes.',
    alt: 'A built-in wardrobe with sliding doors, adjustable shelves, hanging rails and drawers.' },
  { title: 'Vanities', place: 'Brisbane', src: '/jobs/vanity-marble.jpg', w: 1080, h: 1440, pos: '50% 60%',
    body: 'Floating and floor-standing vanities, with HMR moisture-resistant board for wet areas.',
    alt: 'A white floating vanity with an integrated basin and mirrored cabinet in a marble-tiled bathroom.' },
];
---
<section id="portfolio" class="cols" aria-label="Our work">
  {cols.map((c) => (
    <article class="col">
      <img src={c.src} width={c.w} height={c.h} alt={c.alt} loading="lazy" style={`object-position:${c.pos}`} />
      <div class="text">
        <h2>{c.title}</h2>
        <p>{c.body}</p>
        <div class="row">
          <a class="btn btn--white" href={plannerHref} {...ext}>Plan in 3D <span aria-hidden="true">↗</span></a>
          <a class="btn btn--accent" href="#quote">Get a quote <span class="dot" aria-hidden="true"></span></a>
        </div>
      </div>
      <span class="place">{c.place}</span>
    </article>
  ))}
</section>

<style>
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .col { background: var(--dark); position: relative; min-height: clamp(560px, 88vh, 820px); color: #fff; isolation: isolate; overflow: hidden; }
  .col img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease); }
  .col:hover img { transform: scale(1.03); }
  /* neutral scrim behind the copy at the top */
  .col::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to bottom, rgb(var(--scrim) / .72) 0%, rgb(var(--scrim) / .42) 36%, transparent 64%); }
  .text { padding: clamp(32px, 3.5vw, 48px); }
  h2 { font-size: clamp(1.9rem, 2.6vw, 2.5rem); font-weight: 600; letter-spacing: -.02em; }
  .text p { margin-top: 12px; max-width: 34ch; font-size: 1rem; line-height: 1.5; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .place { position: absolute; left: clamp(32px, 3.5vw, 48px); bottom: 24px; font-size: .8125rem; background: rgb(255 255 255 / .92); color: var(--ink); padding: 7px 14px; border-radius: 999px; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } .col { min-height: 520px; } }
</style>
