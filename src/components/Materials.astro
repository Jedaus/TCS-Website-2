---
import { ADDRESS, MAP_URL } from '../config';
const brands = [
  ['Polytec', 'Doors, panels and decorative finishes'],
  ['Laminex', 'Finishes and laminate benchtops'],
  ['Blum', 'Austrian hinges, runners and lift systems'],
  ['Australian Made', 'High-density boards, standard or HMR'],
];
---
<section class="section band" id="materials">
  <div class="wrap">
    <h2 class="dual head">Premium materials. <b>Brands you already trust.</b></h2>
    <ul class="brands">
      {brands.map(([name, what]) => (<li class="card"><span>{name}</span>{what}</li>))}
    </ul>
    <a class="visit" href={MAP_URL} target="_blank" rel="noopener">
      <span class="dot" aria-hidden="true"></span>
      <strong>Visit our Woodridge Selection Centre — walk-ins welcome.</strong>
      <span class="where">Display counters, Polytec and Laminex finish chips and Blum hardware to handle. {ADDRESS} ↗</span>
    </a>
  </div>
</section>

<style>
  .head { max-width: 20ch; margin-bottom: 56px; }
  .brands { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .brands li { padding: 32px 28px; color: var(--muted); font-size: .9375rem; }
  .brands span { display: block; color: var(--ink); font-size: 1.5rem; font-weight: 600; letter-spacing: -.02em; margin-bottom: 10px; }
  .visit {
    display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; align-items: baseline;
    margin-top: 48px; padding: 28px 32px; text-decoration: none;
    border-radius: var(--radius); background: #fff; border: 1px solid var(--rule);
    transition: border-color .25s var(--ease);
  }
  .visit:hover { border-color: var(--accent); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .visit strong { font-weight: 600; font-size: 1.125rem; }
  .where { grid-column: 2; color: var(--muted); font-size: .9375rem; max-width: 64ch; }
  @media (max-width: 900px) { .brands { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .brands { grid-template-columns: 1fr; } }
</style>
