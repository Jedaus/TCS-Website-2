---
import { PHONE, PHONE_HREF, EMAIL, ADDRESS, MAP_URL, portalHref, GOCABINETS_PORTAL_URL } from '../config';
const ext = GOCABINETS_PORTAL_URL ? { target: '_blank', rel: 'noopener' } : {};
---
<footer class="foot">
  <div class="wrap">
    <div class="top">
      <h2 class="dual">The Woodridge workshop. <b>Come and see the boards.</b></h2>
      <a class="btn btn--white" href={portalHref} {...ext}>Trade Login <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="cols">
      <div><dt>Workshop</dt><dd><a href={MAP_URL} target="_blank" rel="noopener">{ADDRESS} ↗</a></dd></div>
      <div><dt>Phone</dt><dd><a href={PHONE_HREF}>{PHONE}</a></dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd></div>
    </dl>
    <p class="fine">Total Cabinet Supplies manufactures and supplies custom flat pack cabinetry. We do not install.</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--dark); color: var(--bg);
    border-radius: 32px 32px 0 0;
    padding-block: var(--section) 48px;
  }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 72px 0 0; padding-top: 40px; border-top: 1px solid rgb(250 248 245 / .14); }
  dt { color: var(--muted-dark); font-size: .8125rem; margin-bottom: 8px; }
  dd { margin: 0; font-size: 1.0625rem; }
  dd a { text-decoration: none; }
  dd a:hover { text-decoration: underline; }
  .fine { margin-top: 72px; color: var(--muted-dark); font-size: .8125rem; max-width: 60ch; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
