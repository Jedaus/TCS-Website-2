---
import '@fontsource-variable/work-sans';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const finishes = [
  { name: 'Natural Oak', hex: '#DCC79A' },
  { name: 'Golden Walnut', hex: '#8A5A34' },
  { name: 'Dark Chocolate', hex: '#4A2E1E' },
  { name: 'Pure White', hex: '#F2EDE3' },
  { name: 'Stone Grey', hex: '#B7B0A6' },
  { name: 'Matte Black', hex: '#1E1E1E' },
  { name: 'Mixed Pack (12 colours)', hex: '#7A4A2E' },
];

const related = [
  { name: 'Blum Soft-Close Hinges (Pair)', desc: '110° clip-top, full overlay', price: '$18.50' },
  { name: 'Cam Lock & Dowel Fixing Kit', desc: '50-set, includes drive bit', price: '$22.00' },
  { name: 'Edge Banding Tape — Oak', desc: '22mm x 5m, iron-on', price: '$9.90' },
  { name: 'Cabinet Levelling Feet (4-Pack)', desc: 'Adjustable 100–140mm', price: '$11.20' },
];
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Screw Cover Cap Stickers — Shop | Total Cabinet Supplies</title>
    <meta name="description" content="Self-adhesive screw cover cap stickers matched to Polytec & Laminex finishes. Hide screw heads and cam locks on flat pack cabinetry. Pickup at Woodridge or delivered SE QLD." />
  </head>
  <body id="top">
    <Header />
    <main>
      <section class="wrap crumb">
        <a href="/">Home</a><span aria-hidden="true">›</span>
        <a href="/shop">Shop</a><span aria-hidden="true">›</span>
        <span>Screw Cover Caps</span>
      </section>

      <section class="wrap product">
        <div class="gallery">
          <div class="gallery-main">
            <img src="/jobs/screw-cap-stickers.jpg" width="1200" height="930"
              alt="Self-adhesive screw cover cap stickers, 12 sheets in assorted timber finishes" />
          </div>
        </div>

        <div class="info">
          <div class="badges">
            <span class="badge badge--stock">In stock</span>
            <span class="badge">Ships from Woodridge</span>
          </div>
          <h1 class="title">Self-Adhesive Screw Cover Cap Stickers</h1>
          <p class="sub">12-sheet timber match pack — peel-and-stick caps for hiding screw heads and cam locks on flat pack cabinetry, matched to Polytec &amp; Laminex finishes.</p>

          <div class="price-row">
            <span class="price">$14.90</span>
            <span class="price-unit">per 12-sheet pack · ~200 caps</span>
          </div>

          <div class="rule"></div>

          <div class="option-group">
            <span class="option-label">Finish</span>
            <div class="swatches" id="swatches">
              {finishes.map((f, i) => (
                <label class:list={['swatch', { selected: i === 0 }]}>
                  <input type="radio" name="finish" value={f.name} checked={i === 0} />
                  <span class="dot" style={`background:${f.hex}`}></span>{f.name}
                </label>
              ))}
            </div>
          </div>

          <div class="option-group">
            <span class="option-label">Quantity</span>
            <div class="qty-row">
              <div class="stepper">
                <button type="button" id="qtyMinus" aria-label="Decrease quantity">−</button>
                <span class="val" id="qtyVal">1</span>
                <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
              </div>
              <span class="note">1 pack covers approx. one full kitchen</span>
            </div>
          </div>

          <div class="cta-row">
            <button type="button" class="btn btn--accent" id="addBtn">Add to Cart · $14.90</button>
            <a class="btn btn--line" href="#quote-note">Bulk / trade quote</a>
          </div>

          <ul class="trust-list">
            <li>Matched to Blum &amp; TCS hardware finishes</li>
            <li>Pickup at Woodridge or delivered SE QLD</li>
            <li>Trade pricing available with goCabinets login</li>
          </ul>
        </div>
      </section>

      <section class="wrap specs">
        <h2 class="dual dual--lead">Description &amp; <b>specifications</b></h2>
        <div class="specs-grid">
          <div class="specs-copy">
            <p>Hide exposed screw heads, cam-lock covers and hinge-plate fixings with a clean, colour-matched finish. Each sheet carries pre-cut circular caps sized for standard 15–20mm confirmat and cam screw heads — the same fixings used across TCS flat pack kits.</p>
            <p>Printed with a fine wood-grain texture that reads true under kitchen lighting, not a flat colour block. Repositionable for the first few seconds of placement, then permanent bond once pressed — no silicone or filler needed.</p>
          </div>
          <table class="spec-table">
            <tr><td>Sheets per pack</td><td>12</td></tr>
            <tr><td>Caps per sheet</td><td>~17 (204 total)</td></tr>
            <tr><td>Cap diameter</td><td>13mm</td></tr>
            <tr><td>Material</td><td>PVC film, acrylic adhesive</td></tr>
            <tr><td>Finish match</td><td>Polytec &amp; Laminex ranges</td></tr>
            <tr><td>Use</td><td>Cabinetry, wardrobes, vanities</td></tr>
          </table>
        </div>
      </section>

      <section class="band related">
        <div class="wrap">
          <h2 class="dual dual--lead">You might also <b>need</b></h2>
          <div class="grid-4">
            {related.map((p) => (
              <div class="pcard">
                <div class="pcard-img"><img src="/jobs/screw-cap-stickers.jpg" alt="" width="400" height="344" /></div>
                <div class="pcard-body">
                  <div class="pcard-name">{p.name}</div>
                  <div class="pcard-desc">{p.desc}</div>
                  <div class="pcard-foot">
                    <span class="pcard-price">{p.price}</span>
                    <span class="pcard-add" aria-hidden="true">+</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <p id="quote-note" class="wrap fine-note">Ordering more than a few packs, or need it matched to a specific job? <a href="/#quote">Send us a quote request</a> and we'll sort trade pricing.</p>
    </main>
    <Footer />

    <div class="toast" id="toast">
      <span id="toastText">Added to cart</span>
    </div>

    <script>
      const swatches = document.querySelectorAll('#swatches .swatch');
      swatches.forEach((s) => {
        s.addEventListener('click', () => {
          swatches.forEach((x) => x.classList.remove('selected'));
          s.classList.add('selected');
        });
      });

      let qty = 1;
      const unitPrice = 14.9;
      const qtyVal = document.getElementById('qtyVal')!;
      const addBtn = document.getElementById('addBtn')!;
      function renderQty() {
        qtyVal.textContent = String(qty);
        addBtn.textContent = `Add to Cart · $${(qty * unitPrice).toFixed(2)}`;
      }
      document.getElementById('qtyPlus')!.addEventListener('click', () => { qty++; renderQty(); });
      document.getElementById('qtyMinus')!.addEventListener('click', () => { if (qty > 1) qty--; renderQty(); });

      const toast = document.getElementById('toast')!;
      const toastText = document.getElementById('toastText')!;
      addBtn.addEventListener('click', () => {
        toastText.textContent = `Added ${qty} pack${qty > 1 ? 's' : ''} to cart`;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2200);
      });
    </script>

    <style>
      .crumb { padding-top: 28px; font-size: .8125rem; color: var(--muted); display: flex; gap: 8px; align-items: center; }
      .crumb a:hover { text-decoration: underline; }
      .crumb span:last-child { color: var(--ink); font-weight: 500; }

      .product {
        padding-block: 32px clamp(64px, 8vw, 100px);
        display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 72px);
      }
      @media (max-width: 900px) { .product { grid-template-columns: 1fr; } }

      .gallery-main {
        aspect-ratio: 4 / 3.1; border-radius: var(--radius); overflow: hidden;
        background: var(--band); border: 1px solid var(--rule);
      }
      .gallery-main img { width: 100%; height: 100%; object-fit: cover; }

      .badges { display: flex; gap: 8px; margin-bottom: 14px; }
      .badge {
        font-size: .75rem; font-weight: 600; letter-spacing: .02em;
        padding: 5px 12px; border-radius: 999px; background: var(--tint); color: var(--accent-deep);
      }
      .badge--stock { background: var(--tint); color: var(--accent-deep); }

      .title { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 600; letter-spacing: -.01em; line-height: 1.15; }
      .sub { color: var(--muted); margin-top: 10px; max-width: 52ch; }

      .price-row { display: flex; align-items: baseline; gap: 12px; margin-top: 22px; }
      .price { font-size: 1.9rem; font-weight: 700; letter-spacing: -.01em; }
      .price-unit { color: var(--muted); font-size: .875rem; }

      .rule { height: 1px; background: var(--rule); margin: 26px 0; }

      .option-group { margin-bottom: 22px; }
      .option-label { font-size: .8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-bottom: 10px; display: block; }
      .swatches { display: flex; flex-wrap: wrap; gap: 10px; }
      .swatch {
        display: flex; align-items: center; gap: 8px;
        border: 1.5px solid var(--rule); border-radius: 10px;
        padding: 8px 12px 8px 8px; cursor: pointer; transition: border-color .2s, background .2s;
        font-size: .8125rem; font-weight: 500;
      }
      .swatch input { position: absolute; opacity: 0; width: 0; height: 0; }
      .swatch:hover { border-color: var(--accent); }
      .swatch.selected { border-color: var(--accent); background: var(--tint); }
      .swatch .dot { width: 22px; height: 22px; border-radius: 50%; border: 1px solid rgb(0 0 0 / .1); flex-shrink: 0; }

      .qty-row { display: flex; align-items: center; gap: 16px; }
      .stepper { display: flex; align-items: center; border: 1.5px solid var(--rule); border-radius: 999px; overflow: hidden; }
      .stepper button { width: 38px; height: 38px; border: none; background: #fff; font-size: 1.1rem; cursor: pointer; color: var(--ink); }
      .stepper button:hover { background: var(--band); }
      .stepper .val { width: 44px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }
      .note { font-size: .8125rem; color: var(--muted); }

      .cta-row { display: flex; gap: 12px; margin-top: 28px; }
      .cta-row .btn { flex: 1; justify-content: center; }
      .cta-row .btn--line { flex: 0 0 auto; padding-inline: 22px; }

      .trust-list { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
      .trust-list li { font-size: .875rem; color: var(--muted); padding-left: 22px; position: relative; }
      .trust-list li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }

      .specs { padding-block: 0 clamp(64px, 8vw, 100px); }
      .specs-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; margin-top: 32px; }
      @media (max-width: 800px) { .specs-grid { grid-template-columns: 1fr; } }
      .specs-copy p { color: var(--muted); max-width: 60ch; }
      .specs-copy p + p { margin-top: 14px; }
      .spec-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
      .spec-table tr { border-bottom: 1px solid var(--rule); }
      .spec-table td { padding: 12px 0; }
      .spec-table td:first-child { color: var(--muted); width: 42%; }
      .spec-table td:last-child { font-weight: 500; }

      .related { padding-block: clamp(64px, 8vw, 100px); }
      .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; margin-top: 40px; }
      @media (max-width: 900px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 520px) { .grid-4 { grid-template-columns: 1fr; } }

      .pcard {
        background: #fff; border: 1px solid var(--rule); border-radius: var(--radius);
        overflow: hidden; transition: box-shadow .25s var(--ease), transform .25s var(--ease);
      }
      .pcard:hover { box-shadow: 0 16px 32px -16px rgb(24 38 41 / .18); transform: translateY(-3px); }
      .pcard-img { aspect-ratio: 1 / .86; background: var(--tint); overflow: hidden; }
      .pcard-img img { width: 100%; height: 100%; object-fit: cover; }
      .pcard-body { padding: 16px 18px 20px; }
      .pcard-name { font-size: .9375rem; font-weight: 600; }
      .pcard-desc { font-size: .8125rem; color: var(--muted); margin-top: 4px; }
      .pcard-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; }
      .pcard-price { font-weight: 700; }
      .pcard-add {
        width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff;
        display: grid; place-items: center; font-size: 1.1rem;
      }

      .fine-note { padding-block: 0 clamp(64px, 8vw, 100px); color: var(--muted); font-size: .9375rem; }
      .fine-note a { color: var(--accent); font-weight: 600; }

      .toast {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(120%);
        background: var(--ink); color: #fff; padding: 14px 22px; border-radius: 999px;
        font-size: .875rem; font-weight: 500;
        transition: transform .35s var(--ease); z-index: 50; box-shadow: 0 12px 28px -8px rgb(0 0 0 / .35);
      }
      .toast.show { transform: translateX(-50%) translateY(0); }
    </style>
  </body>
</html>
