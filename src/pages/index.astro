---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Planner3D from '../components/Planner3D.astro';
import Comparison from '../components/Comparison.astro';
import TradeAdvantage from '../components/TradeAdvantage.astro';
import Materials from '../components/Materials.astro';
import FAQ from '../components/FAQ.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Total Cabinet Supplies — Custom Flat Pack Cabinetry, Woodridge QLD</title>
    <meta name="description" content="Millimetre-perfect custom flat pack kitchens, wardrobes and vanities made at our Woodridge factory. Australian Made boards, Blum hardware, 3D planning, same-day remakes. Supply and manufacture only." />
  </head>
  <body id="top">
    <Header />
    <main>
      <Hero />
      <Showcase />
      <Planner3D />
      <Comparison />
      <TradeAdvantage />
      <Materials />
      <FAQ />
      <QuoteForm />
    </main>
    <Footer />
  </body>
</html>
